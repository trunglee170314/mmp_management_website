DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10
TIME_ZONE=Asia/Ho_Chi_Minh
APP_VERSION=1.0.0
APP_PORT=8080
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
# Optional second disk/NAS: create/mount the folder first, then uncomment both.
# COMPOSE_FILE=docker-compose.yml:deploy/backup-export.compose.yml
# BACKUP_EXPORT_PATH=/mnt/secure-backups/mmp
# Optional encrypted GitLab backup (can be combined with the NAS overlay):
# Example: Linux admin; register the public SSH key in GitLab trungvanle's SSH Keys.
# COMPOSE_FILE=docker-compose.yml:deploy/backup-git.compose.yml
# BACKUP_GIT_REPO=git@gitlab.example.com:trungvanle/mmp-backups.git
# BACKUP_GIT_BRANCH=main
# BACKUP_GIT_TIMEOUT_SECONDS=120
# BACKUP_GIT_SSH_KEY_PATH=/home/admin/.ssh/mmp_gitlab_trungvanle
# BACKUP_GIT_KNOWN_HOSTS_PATH=/home/admin/.ssh/mmp_gitlab_known_hosts
# BACKUP_AGE_RECIPIENTS_PATH=/home/admin/.config/mmp-backup/recipients.txt
MAINTENANCE_INTERVAL_SECONDS=86400

POSTGRES_DB=mmp_management
POSTGRES_USER=mmp_management
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=System Admin
ADMIN_RESET_PASSWORD=0
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
TIMELINE_MAX_FUTURE_YEARS=10
